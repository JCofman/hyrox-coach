{
  "name": "hyrox-coach",
  "version": "0.1.0",
  "author": "Jacob Cofman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCofman/hyrox-coach.git"
  },
  "homepage": "https://github.com/JCofman/hyrox-coach#readme",
  "bugs": {
    "url": "https://github.com/JCofman/hyrox-coach/issues"
  },
  "type": "module",
  "bin": {
    "hyrox-coach": "bin/hyrox-coach.js"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.sql",
    "templates"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "npm run build:ts && npm run build:viewer && npm run build:skill",
    "build:ts": "tsc && cp src/db/schema.sql dist/db/",
    "build:viewer": "vite build --config vite.config.viewer.ts",
    "build:skill": "mkdir -p dist && cd skill && zip -r ../dist/hyrox-coach-skill.zip . -x '*.DS_Store' && echo 'Skill packaged to dist/hyrox-coach-skill.zip'",
    "dev": "tsx watch src/cli.ts",
    "dev:viewer": "vite --config vite.config.viewer.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "build:example": "node bin/hyrox-coach.js render examples/sample-plan.json --output examples/sample-plan.html"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.178.0",
    "consola": "^3.2.3",
    "jszip": "^3.10.1",
    "open": "^10.1.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.43.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.2.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "description": "Claude skill and CLI that builds personalized Hyrox training plans from Apple Health, Garmin, Google or Strava data",
  "contributors": [
    "Felix Rieseberg <felix@felixrieseberg.com> (https://felixrieseberg.com) - original claude-coach"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hyrox",
    "training-plan",
    "coach",
    "claude",
    "claude-skill",
    "apple-health",
    "garmin",
    "strava",
    "fitness"
  ]
}
